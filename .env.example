# Placeholders only. This repository is public: never put real keys, passwords or connection strings in git.
#
# Local development (no vendor keys needed, the backend uses fake vendors):
#   cp .env.example .env
#   supabase start && supabase db reset      # applies supabase/migrations and supabase/seed.sql
#   pnpm dev:backend                          # api on :8080, worker on :8081
# The database users below are throwaway local-only credentials created by supabase/seed.sql.
AVANVU_ENV=local
DATABASE_URL_API=postgres://avanvu_api:local-dev-api@127.0.0.1:54322/postgres
DATABASE_URL_WORKER=postgres://avanvu_worker:local-dev-worker@127.0.0.1:54322/postgres

# Project identifiers (not secrets). The production project is never used from a developer machine.
SUPABASE_URL=https://xgxhhnrtctaiixylzydv.supabase.co
SUPABASE_JWKS_URL=https://xgxhhnrtctaiixylzydv.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://xgxhhnrtctaiixylzydv.supabase.co/auth/v1

