{
  "name": "@avanvu/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "AVANVU_ROLE=both tsx --env-file=../../.env src/main.ts",
    "build": "node scripts/build.mjs",
    "gen:sports": "tsx src/gen-sports-migration.mts > ../../supabase/migrations/20261011000002_seed_sports.sql"
  },
  "dependencies": {
    "@avanvu/core": "workspace:*",
    "@hono/node-server": "2.1.4",
    "fflate": "0.8.3",
    "hono": "4.13.13",
    "jose": "6.2.12",
    "kysely": "0.29.6",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "ffmpeg-static": "5.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
